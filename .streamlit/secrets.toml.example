# 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채우세요. (secrets.toml 은 절대 GitHub 에 올리지 마세요)
# Streamlit Community Cloud 에서는 앱 설정 → Secrets 에 같은 내용을 붙여 넣습니다.
# 모든 항목은 선택입니다. 비워 두면 해당 기능만 꺼지거나 간이 방식으로 동작합니다.

# ── 필수에 가까운 항목 ──────────────────────────────────────────
APP_SECRET = "여기에-길고-무작위인-문자열"        # 로그인 토큰 서명·얼굴 정보 암호화 키. 한번 정하면 바꾸지 마세요.
APP_BASE_URL = "https://내앱이름.streamlit.app"   # 소셜 로그인·패스키에 쓰는 앱 주소(끝에 / 없이)
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres"   # Supabase 등 Postgres. 없으면 임시 SQLite

# ── AI (장르 분석·문학 번역·홍보 문구·투고 편지·OCR) ─────────────
ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-opus-5-5"            # 기본값. 비용을 줄이려면 다른 모델 ID 로 바꿀 수 있습니다.

# ── 메일 (가입 인증코드·비밀번호 찾기·원터치 투고 발송) ─────────────
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "me@gmail.com"
SMTP_PASSWORD = "앱 비밀번호 16자리"
# SMTP_FROM = "me@gmail.com"                     # 보내는 주소가 로그인 아이디와 다를 때만
# 네이버 메일 예시: SMTP_HOST = "smtp.naver.com", SMTP_PORT = 587, SMTP_USER = "네이버아이디@naver.com"

# ── 소셜 로그인 (쓰는 것만 채우세요) ───────────────────────────────
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
FACEBOOK_CLIENT_ID = ""
FACEBOOK_CLIENT_SECRET = ""
NAVER_CLIENT_ID = ""
NAVER_CLIENT_SECRET = ""
KAKAO_CLIENT_ID = ""
KAKAO_CLIENT_SECRET = ""

# ── 관리자 ───────────────────────────────────────────────────
ADMIN_EMAILS = "me@example.com"                  # 쉼표로 여러 개. 처음 가입한 계정은 자동으로 관리자입니다.
